# ENVIRONMENT/APP_VERSION/COMMIT_SHA are deployment-friendly aliases.
# BACKEND_ENV/BACKEND_VERSION/GIT_COMMIT remain backward-compatible.
ENVIRONMENT=local
BACKEND_ENV=local
APPLICATION_NAME=PackLox API
APP_VERSION=0.1.0
BACKEND_VERSION=0.1.0
COMMIT_SHA=unknown
GIT_COMMIT=unknown
BUILD_TIME=unknown
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://localhost:3000
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,https://sit.packlox.com,https://admin.packlox.com,https://packlox-admin-portal.hariomritesh.workers.dev
HEALTH_TIMEOUT_SECONDS=3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_HEALTH_REQUIRED=false

AI_PROVIDER=mock
PRICING_PROVIDER=mock

# Future server-side AI provider settings. Never place these values in Flutter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# Server-side pricing provider settings. Never place these values in Flutter.
# Preferred eBay setup: backend generates and caches OAuth app tokens from these.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_TOKEN_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE_INSIGHTS_API_URL=
EBAY_PARTNER_ACCESS_GRANTED=false
# Optional short-lived manual fallback for local/SIT testing.
EBAY_ACCESS_TOKEN=
EBAY_BROWSE_API_URL=https://api.ebay.com/buy/browse/v1/item_summary/search
EBAY_MARKETPLACE_ID=EBAY_AU
EBAY_TIMEOUT_SECONDS=10
TCGPLAYER_CLIENT_ID=
TCGPLAYER_CLIENT_SECRET=
TCGPLAYER_API_BASE=https://api.tcgplayer.com
TCGPLAYER_TIMEOUT_SECONDS=10
PRICECHARTING_API_KEY=
PRICECHARTING_API_BASE=https://www.pricecharting.com
PRICECHARTING_TIMEOUT_SECONDS=10
PRICING_CACHE_TTL_SECONDS=900
PRICING_PROVIDER_MIN_INTERVAL_MS=250

# --- Admin credentials -------------------------------------------------------
# Two separate static tokens. They MUST hold different values in production:
# together they are the only credentials that work without a Supabase login.
#
# ADMIN_IMPORT_TOKEN -- the human operational token. Narrowed 2026-09-07 to
#   admin:read, audit:read, imports:run. It runs catalog imports and reads the
#   console's read-only surfaces. It CANNOT write pricing, users, portfolio,
#   catalog metadata, scans, or push -- those need a real Supabase admin
#   session, so the action is attributable to a person.
#
# ADMIN_JOB_TOKEN -- the scheduler's token. Every cron that calls the API
#   authenticates with this. Full capability on the job routes it reaches.
#   If unset it falls back to ADMIN_IMPORT_TOKEN in code -- do not rely on
#   that: set it explicitly, to a different value.
ADMIN_IMPORT_TOKEN=
ADMIN_JOB_TOKEN=
